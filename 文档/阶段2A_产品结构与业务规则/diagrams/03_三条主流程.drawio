        <mxCell id="a_more" value="向客户追问&#xa;记录缺失字段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="720" y="280" width="190" height="70" as="geometry" />
