        <mxCell id="c_biz" value="业务/渠道审批&#xa;提交人不得自批" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1040" y="120" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_eval" value="AI 回归评测&#xa;冻结 12 条核心任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="1040" y="300" width="220" height="80" as="geometry" />
