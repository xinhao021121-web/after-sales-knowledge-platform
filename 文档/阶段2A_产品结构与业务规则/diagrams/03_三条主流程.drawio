        <mxCell id="a_confirm" value="人工确认 / 修改 / 转交" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="700" y="390" width="200" height="80" as="geometry" />
