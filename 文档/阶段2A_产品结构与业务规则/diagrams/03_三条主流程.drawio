        </mxCell>
        <mxCell id="a_adv" value="生成 ADV&#xa;动作 · 证据 · 承诺边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
