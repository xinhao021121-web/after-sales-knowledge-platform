  <diagram name="F04 R2/R3 安全止损和升级">
    <mxGraphModel pageHeight="700" grid="1" gridSize="10" fold="1" tooltips="1" page="1" pageWidth="1600" connect="1" guides="1" arrows="1" shadow="0" pageScale="1" math="0">
