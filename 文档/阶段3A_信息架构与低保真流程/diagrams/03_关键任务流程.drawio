<?xml version="1.0" encoding="utf-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="F01 创建咨询任务并补齐上下文">
    <mxGraphModel pageHeight="700" grid="1" gridSize="10" fold="1" tooltips="1" page="1" pageWidth="1600" connect="1" guides="1" arrows="1" shadow="0" pageScale="1" math="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell value="F01  创建咨询任务并补齐上下文" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=#111111;" id="title" vertex="1" parent="1">
          <mxGeometry width="1200" as="geometry" y="30" height="50" x="40" />
        </mxCell>
        <mxCell value="客户诉求 / 客服入口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontColor=#111111;" id="start" vertex="1" parent="1">
          <mxGeometry width="160" as="geometry" y="150" height="90" x="40" />
        </mxCell>
        <mxCell value="创建 ASQ 并记录原话" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#111111;" id="a1" vertex="1" parent="1">
          <mxGeometry width="240" as="geometry" y="140" height="100" x="250" />
        </mxCell>
        <mxCell value="展示缺失字段并补 CTX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#111111;" id="a2" vertex="1" parent="1">
          <mxGeometry width="240" as="geometry" y="140" height="100" x="530" />
        </mxCell>
        <mxCell value="上下文达到最低判断条件？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#555555;fontColor=#111111;" id="decision" vertex="1" parent="1">
          <mxGeometry width="220" as="geometry" y="135" height="110" x="820" />
        </mxCell>
        <mxCell value="进入证据与建议" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#111111;" id="success" vertex="1" parent="1">
          <mxGeometry width="200" as="geometry" y="140" height="100" x="1080" />
        </mxCell>
        <mxCell value="ASQ_ASSESSING 或进入风险流程" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontColor=#111111;" id="end" vertex="1" parent="1">
          <mxGeometry width="210" as="geometry" y="145" height="90" x="1320" />
        </mxCell>
        <mxCell value="识别失败/重复/无权限" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontColor=#111111;" id="failure" vertex="1" parent="1">
          <mxGeometry width="220" as="geometry" y="330" height="100" x="820" />
        </mxCell>
        <mxCell value="复用原任务、补证或转人工" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#555555;dashed=1;fontColor=#111111;" id="recovery" vertex="1" parent="1">
          <mxGeometry width="260" as="geometry" y="330" height="100" x="1080" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;fontColor=#333333;" source="start" target="a1" edge="1" parent="1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;fontColor=#333333;" source="a1" target="a2" edge="1" parent="1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;fontColor=#333333;" source="a2" target="decision" edge="1" parent="1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;fontColor=#333333;" source="decision" target="success" edge="1" parent="1" value="是/成功">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;fontColor=#333333;" source="success" target="end" edge="1" parent="1" value="完成">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;fontColor=#333333;" source="decision" target="failure" edge="1" parent="1" value="否/异常">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;fontColor=#333333;" source="failure" target="recovery" edge="1" parent="1" value="恢复">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#666666;fontColor=#333333;" source="recovery" target="decision" edge="1" parent="1" value="修复后重试">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#666666;fontColor=#333333;" source="recovery" target="end" edge="1" parent="1" value="升级/终止">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell value="失败：识别失败/重复/无权限&#xA;恢复：复用原任务、补证或转人工&#xA;终点：ASQ_ASSESSING 或进入风险流程" style="text;html=1;fontSize=14;align=left;verticalAlign=top;fontColor=#444444;" id="note" vertex="1" parent="1">
          <mxGeometry width="1490" as="geometry" y="500" height="100" x="40" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="F02 证据不足时追问和补证">
    <mxGraphModel pageHeight="700" grid="1" gridSize="10" fold="1" tooltips="1" page="1" pageWidth="1600" connect="1" guides="1" arrows="1" shadow="0" pageScale="1" math="0">
