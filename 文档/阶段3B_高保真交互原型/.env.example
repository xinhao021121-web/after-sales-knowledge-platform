# Local-only BFF configuration. Copy to .env.local and fill secrets locally.
RAG_PROVIDER=dify
RAG_BASE_URL=https://api.dify.ai/v1
RAG_API_KEY=
RAG_DIFY_DATASET_BASE_URL=https://api.dify.ai/v1
RAG_DIFY_DATASET_API_KEY=
RAG_DIFY_APP_ID=
RAG_DIFY_DATASET_ID=
RAG_GENERATION_MODEL=deepseek-v4-pro
RAG_REQUEST_TIMEOUT_MS=45000
RAG_MAX_RETRIES=1
BFF_HOST=127.0.0.1
BFF_PORT=8787
BFF_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
BFF_DEMO_TENANT=tenant-demo
BFF_ENVIRONMENT=candidate
