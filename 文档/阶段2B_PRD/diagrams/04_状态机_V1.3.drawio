      <mxCell id="pe7" value="新问题 / EV-18 来源失效" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;" edge="1" parent="1" source="p7" target="p8"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="pe8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;" edge="1" parent="1" source="p8" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="pe9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p2" target="p9"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="pnote" value="CASE 与 KB 版本通过 CASE_LINK(case_id, kb_version_id) 形成 0..N 关联；REL 创建后补充 rel_id。&#xa;来源失效且 CASE 未关闭时 EV-18 进入 CASE_FIXING；CASE 已关闭时进入 CASE_REOPENED；无 CASE 时新建 CASE_OPEN。&#xa;一个 REL 生效后，EV-11 关闭该 KB 版本关联的全部满足条件 CASE。" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="1280" height="100" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram name="评测任务">
    <mxGraphModel pageWidth="1200" pageHeight="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="et" value="评测任务 EVAL｜结果驱动跨对象推进" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="800" height="40" as="geometry"/></mxCell>
      <mxCell id="e1" value="待执行" style="rounded=1;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="150" height="60" as="geometry"/></mxCell>
      <mxCell id="e2" value="执行中" style="rounded=1;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="240" y="120" width="150" height="60" as="geometry"/></mxCell>
      <mxCell id="e3" value="通过" style="rounded=1;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="440" y="120" width="150" height="60" as="geometry"/></mxCell>
      <mxCell id="e4" value="失败" style="rounded=1;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="440" y="280" width="150" height="60" as="geometry"/></mxCell>
      <mxCell id="e5" value="受阻" style="rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="240" y="280" width="150" height="60" as="geometry"/></mxCell>
      <mxCell id="ee1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="e1" target="e2"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="ee2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="e2" target="e3"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="ee3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;" edge="1" parent="1" source="e2" target="e4"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="ee4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="e2" target="e5"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="ee5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;" edge="1" parent="1" source="e1" target="e5"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="ee6" value="阻塞解除" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="e5" target="e1"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="enote" value="EV-08：EVAL_PASSED 保持通过，同时原子更新 KB、全部关联 CASE（0..N）、创建 REL_PENDING_APPROVAL 并写 AUD。&#xa;无 CASE 时允许正常首次发布；EV-09：评测失败保持 EVAL_FAILED，并创建或重开 CASE_FIXING。" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1080" height="70" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram name="发布版本">
    <mxGraphModel pageWidth="1200" pageHeight="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="rt" value="发布版本 REL 状态｜对外生效的唯一归属" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="800" height="40" as="geometry"/></mxCell>
      <mxCell id="r1" value="待批准" style="rounded=1;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="150" height="60" as="geometry"/></mxCell>
      <mxCell id="r2" value="已发布 REL_ACTIVE" style="rounded=1;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="260" y="120" width="180" height="60" as="geometry"/></mxCell>
      <mxCell id="r3" value="已替代 SUPERSEDED" style="rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="520" y="120" width="190" height="60" as="geometry"/></mxCell>
      <mxCell id="r4" value="已停用 SUSPENDED" style="rounded=1;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="520" y="280" width="190" height="60" as="geometry"/></mxCell>
      <mxCell id="r5" value="已回滚 ROLLED_BACK" style="rounded=1;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="800" y="280" width="200" height="60" as="geometry"/></mxCell>
      <mxCell id="r0" value="已拒绝 REJECTED" style="rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="180" height="60" as="geometry"/></mxCell>
      <mxCell id="re1" value="EV-16 激活" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="re0" value="拒绝" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="r1" target="r0"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="re2" value="同 knowledge_item 的旧 ACTIVE 被替代" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="re3" value="严重异常" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;" edge="1" parent="1" source="r2" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="re4" value="新回滚候选重新审批并激活后" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="r4" target="r5"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="rnote" value="P0：一个 REL 只绑定一个 kb_version_id；REL_ACTIVE 在 tenant_id + environment_id + business_domain_id + knowledge_item_id 下唯一。&#xa;EV-12：从 ACTIVE 停用并创建新回滚候选；EV-17：从 SUSPENDED 创建新回滚候选。历史 REL 不得改回 ACTIVE。&#xa;回滚失败时，原故障 REL 保持 SUSPENDED，新候选保持 PENDING_APPROVAL 或 REJECTED；业务域级批量发布快照属于 P1。" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1100" height="100" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
</mxfile>
