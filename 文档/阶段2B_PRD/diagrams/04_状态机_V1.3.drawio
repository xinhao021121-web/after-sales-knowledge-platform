      <mxCell id="p4" value="修复中" style="rounded=1;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="610" y="120" width="140" height="60" as="geometry"/></mxCell>
      <mxCell id="p5" value="回归待执行" style="rounded=1;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="800" y="120" width="140" height="60" as="geometry"/></mxCell>
      <mxCell id="p6" value="评测通过待发布" style="rounded=1;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="990" y="120" width="170" height="60" as="geometry"/></mxCell>
      <mxCell id="p7" value="已关闭" style="ellipse;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="990" y="300" width="170" height="60" as="geometry"/></mxCell>
      <mxCell id="p8" value="已重开 REOPENED" style="rounded=1;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="610" y="300" width="160" height="60" as="geometry"/></mxCell>
      <mxCell id="p9" value="已延期" style="rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="300" width="140" height="60" as="geometry"/></mxCell>
      <mxCell id="pe1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
