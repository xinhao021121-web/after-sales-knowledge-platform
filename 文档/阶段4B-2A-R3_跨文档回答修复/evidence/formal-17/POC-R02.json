  "answer_goals": [
    {
      "index": "一",
      "title": "目标一：过保后能否付费维修",
      "content": "判断：已过保 2 个月，仍可咨询保外维修；但需先核验产品身份（型号、序列号、购买凭证、渠道），不直接承诺退换或免费维修。故障“充电不稳定”及“维修历史无”的具体影响正文未覆盖，以官方检测为准。 下一步：携带 AirPods Pro 3 及购买凭证、序列号，到 Apple Store 直营或官方在线服务入口申请保外维修检测；同时确认购买渠道是官方还是第三方，以匹配对应服务入口。 依据：[1][2][3]",
      "evidence_supported": true
    },
    {
      "index": "二",
      "title": "目标二：价格能否先确定",
      "content": "判断：不能先确定；保外维修费用、零件可用性和库存以检测结果及官方服务页面为准，检测前不得给出固定报价或免费承诺。 下一步：提交官方检测后，由服务页面/直营店出具费用，再决定是否维修；维修或更换部件通常提供 90 天质量保证（若原保修剩余更长按较长者）。 依据：[2]",
      "evidence_supported": true
    }
  ],
